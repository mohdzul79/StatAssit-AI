{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["admin", "researcher", "member"] },
        "institution": { "type": "string", "maxLength": 256 },
        "department": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "name", "role"]
    },
    "Dataset": {
      "title": "Dataset",
      "description": "User research datasets and variables",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 1000 },
        "rowCount": { "type": "number" },
        "colCount": { "type": "number" },
        "columns": { "type": "array" },
        "data": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "name"]
    },
    "AnalysisResult": {
      "title": "AnalysisResult",
      "description": "Saved inferential analysis outputs and APA narratives",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "testType": { "type": "string", "maxLength": 64 },
        "testName": { "type": "string", "maxLength": 128 },
        "datasetName": { "type": "string", "maxLength": 256 },
        "result": { "type": "object" },
        "apaWriteup": { "type": "string", "maxLength": 20000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "testType", "testName"]
    },
    "ScholarMember": {
      "title": "ScholarMember",
      "description": "Directory of academic scholars and collaborators",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "role": { "type": "string", "enum": ["admin", "researcher", "member"] },
        "institution": { "type": "string", "maxLength": 256 },
        "department": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User feedback, bug reports, and suggestions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "rating": { "type": "number" },
        "category": { "type": "string", "maxLength": 64 },
        "comment": { "type": "string", "maxLength": 4000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "comment"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile information"
    },
    "/users/{userId}/datasets/{datasetId}": {
      "schema": "Dataset",
      "description": "Research datasets created by or assigned to user"
    },
    "/users/{userId}/analyses/{analysisId}": {
      "schema": "AnalysisResult",
      "description": "Statistical calculations and APA draft reports"
    },
    "/directory/{memberId}": {
      "schema": "ScholarMember",
      "description": "Faculty and scholar directory"
    },
    "/feedbacks/{feedbackId}": {
      "schema": "Feedback",
      "description": "Feedback and usability submissions"
    }
  }
}
