rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mohdzul@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*mohdzul.*'))
      );
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) &&
        request.resource.data.id is string &&
        request.resource.data.name is string && request.resource.data.name.size() <= 128 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 256;
      allow delete: if isAdmin();

      // Subcollection: Datasets
      match /datasets/{datasetId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Subcollection: Analyses
      match /analyses/{analysisId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Scholar Directory
    match /directory/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User feedbacks
    match /feedbacks/{feedbackId} {
      allow create: if isSignedIn() || request.resource.data.userId is string;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
